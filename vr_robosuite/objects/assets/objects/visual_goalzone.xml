<?xml version="1.0" encoding="utf-8"?>
<mujoco model="goalzone">
    <asset>
        <!-- RGBA materials for transparency - no textures needed -->
        <material name="greenzone" rgba="0.3 1.0 0.3 0.1" specular="0.3" shininess="0.1" />
    </asset>
  
    <worldbody>
        <body>
            <body name="object">
                <!-- Main cube body - depth (x), width (y), height (z) -->
                <geom name="cube" type="box" size="0.2 0.2 0.2" material="greenzone" group="1" conaffinity="0" contype="0"/>
            </body>
            <!-- Reference sites for placement -->
            <site rgba="0 0 0 0" size="0.005" pos="0 0 -0.1" name="bottom_site"/>
            <site rgba="0 0 0 0" size="0.005" pos="0 0 0.1" name="top_site"/>
            <site rgba="0 0 0 0" size="0.2" pos="0 0 0" name="horizontal_radius_site"/>
        </body>
    
    </worldbody>
</mujoco>